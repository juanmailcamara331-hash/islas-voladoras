{
  "version": "1.0",
  "updated_at": "2026-09-18",
  "purpose": "Capa transversal de seguridad, abuso, antifraude y resiliencia para todo ISL.",
  "doctrine": [
    "Zero Trust: ningún usuario, dispositivo, build, asset o automatización se considera confiable por ubicación o por ser interno.",
    "Least privilege: cada cuenta, token, workflow y herramienta recibe sólo el acceso necesario.",
    "Fail closed para operaciones sensibles; fail safe para experiencia pública.",
    "Ningún secreto vive en Git, frontend, assets, prompts, logs o documentación pública.",
    "Seguridad es un gate recursivo del Lifecycle OS, no una revisión al final.",
    "Las encuestas son evidencia consultiva; nunca se tratan como votación segura de identidad."
  ],
  "threat_domains": [
    {
      "id": "AUTH",
      "name": "Identidad y acceso",
      "controls": [
        "MFA/passkeys",
        "sesiones HttpOnly/Secure/SameSite",
        "separación público/admin",
        "revocación",
        "rotación"
      ]
    },
    {
