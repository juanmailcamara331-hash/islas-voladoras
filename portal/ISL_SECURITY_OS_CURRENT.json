  "current_findings": [
    {
      "id": "SEC-F01",
      "severity": "SEC1_CRITICAL",
      "status": "OPEN_GOVERNANCE",
      "finding": "Repositorio reportado por Netlify como público; documentos y código no deben considerarse confidenciales.",
      "action": "Cambiar a privado o separar repos público/privado antes de tratar propiedad intelectual como secreta."
    },
    {
      "id": "SEC-F02",
      "severity": "SEC1_CRITICAL",
      "status": "OPEN_ARCHITECTURE",
      "finding": "Centro de Mandos accesible por URL exacta; ocultar enlaces no es control de acceso.",
      "action": "Mover Command Center a superficie autenticada/path-protected o sitio privado separado."
    },
    {
      "id": "SEC-F03",
      "severity": "SEC2_HIGH",
      "status": "MITIGATING",
      "finding": "Endpoint de estado de encuesta susceptible a spam directo.",
      "action": "Same-origin validation + body cap + sanitización + rate limiting."
    },
    {
      "id": "SEC-F04",
      "severity": "SEC2_HIGH",
      "status": "MITIGATING",
      "finding": "Dependencias declaradas como latest y sin lockfile visible.",
      "action": "Generar lockfile, pin/review updates y Dependabot antes de producción real."
    }
  ],
