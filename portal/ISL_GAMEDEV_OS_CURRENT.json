{
  "version": "1.0",
  "updated_at": "2026-09-18",
  "purpose": "Sistema operativo recursivo para diseño, producción, validación, lanzamiento y postproducción de ISL.",
  "principles": [
    "Automatizar preparación, comparación, validación, builds, reporting y handoffs; no automatizar la decisión creativa final.",
    "Cada sistema importante debe declarar dependencias, sinergias, requisitos, pruebas, presupuesto y criterio de salida.",
    "Toda salida de una fase alimenta la siguiente y toda regresión puede devolver el elemento a una fase anterior.",
    "Encuestas, telemetría y playtests aportan evidencia; no sustituyen la confirmación humana.",
    "Marketing, store assets, crowdfunding y comunidad se producen en paralelo desde material real del juego, no al final."
  ],
  "recursive_loop": [
    "HIPOTESIS",
    "VARIANTES",
    "SIMULACION",
    "CQC",
    "ENCUESTA_O_REVISION",
    "CONFIRMACION_AUTOR",
    "IMPLEMENTACION",
    "AUTOTEST",
    "PLAYTEST",
    "TELEMETRIA",
    "CORRECCION",
    "REGRESION",
    "PROFILE",
    "VALIDACION",
    "PRODUCCION",
    "ARCHIVO_APRENDIZAJE"
  ],
  "cross_system_engine": {
    "purpose": "Detectar sinergias, incompatibilidades y requisitos antes de implementar.",
    "rules": [
      "Toda decisión declara consumes, produces, conflicts_with, depends_on y amplifies.",
      "Cambios en SAVE/WORLD/TAGS/DATA disparan revisión de migración y regresión.",
      "Cambios en MOV/COMBAT/ABIL/ANIM/CAM disparan suite de sensación jugable.",
      "Cambios en ART/VFX/RENDER/WORLD disparan screenshot comparison y presupuesto GPU.",
      "Cambios en NARR/PATH/REL/EVO disparan simulación de estados y continuidad.",
      "Cambios en UI/ACCESS/LOC disparan matriz de resoluciones, idiomas e input."
    ],
    "outputs": [
      "dependency_graph",
      "synergy_report",
      "risk_register",
      "required_tests",
      "affected_assets",
      "estimated_rework"
    ]
  },
  "lifecycle": [
    {
      "id": "VISION",
      "name": "Visión / pilares",
      "exit": [
        "promesa jugable",
        "ADN visual",
        "audiencia",
        "scope guardrails"
      ]
    },
    {
      "id": "PREPROD",
      "name": "Preproducción",
      "exit": [
