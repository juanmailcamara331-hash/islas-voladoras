  "playtest_program": [
    {
      "stage": "LAB",
      "audience": "equipo/autor",
      "goal": "falsar mecánica rápido",
      "sample": "pequeño"
    },
    {
      "stage": "FRIENDS",
      "audience": "amigos segmentados",
      "goal": "comprensión y emoción sin explicar",
      "sample": "5-15"
    },
    {
      "stage": "CLOSED",
      "audience": "jugadores objetivo",
      "goal": "retención/fricción/balance",
      "sample": "20-100"
    },
    {
      "stage": "STEAM_PLAYTEST",
      "audience": "público controlado",
      "goal": "hardware, UX, métricas, estabilidad",
      "sample": "escalable"
    },
    {
      "stage": "DEMO",
      "audience": "público",
      "goal": "conversión/wishlist y claridad de promesa",
      "sample": "abierto"
    }
  ],
  "voting_governance": {
    "modes": [
      {
        "id": "PUBLIC",
        "use": "arte, sensación, claridad, preferencia de exploración, marketing",
        "spoilers": "bajo"
      },
      {
        "id": "BLIND_A_B",
        "use": "movimiento, UI, audio, balance perceptivo",
        "spoilers": "bajo"
      },
      {
        "id": "FOCUS_GROUP",
        "use": "argumento, personajes, ritmo, emoción",
        "spoilers": "medio",
        "rule": "segmentar y evitar revelar giros"
      },
      {
        "id": "EXPERT",
        "use": "arquitectura, rendimiento, accesibilidad, economía, QA",
        "spoilers": "variable"
      },
      {
        "id": "INTERNAL_SIM",
        "use": "mutación profunda, sistema de memoria, giros, finales",
        "spoilers": "alto"
      }
    ],
    "narrative_rule": "Argumento sí puede refinarse por votación/revisión, pero preguntar por claridad, interés, emoción, ritmo y comprensión; no delegar el canon ni revelar misterios clave.",
    "weighting": "Registrar audiencia y contexto. No mezclar votos de expertos, fans, amigos y jugadores fríos como si fueran la misma señal."
  },
