{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISL Semantic Event Packet",
  "type": "object",
  "required": [
    "event_id",
    "run_id",
    "device",
    "kind",
    "tick",
    "payload_version"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "device": {
      "type": "string",
      "enum": [
        "R36",
        "TABLET",
        "DESKTOP",
        "UNREAL_TEST"
      ]
    },
    "kind": {
      "type": "string"
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "payload_version": {
      "type": "integer",
      "minimum": 1
    },
    "gesture": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "distance": {
          "type": "integer",
          "minimum": 0
        },
        "direction_changes": {
          "type": "integer",
          "minimum": 0
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "voice": {
      "type": "object",
      "properties": {
        "energy_band": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "rhythm_class": {
          "type": "integer",
          "minimum": 0
        },
        "pitch_change_band": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "game": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "tempo": {
      "type": "object",
      "properties": {
        "band": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "sample_window": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "biography": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "integer",
          "minimum": 1
        },
        "encounters": {
          "type": "integer",
          "minimum": 0
        },
        "uses": {
          "type": "integer",
          "minimum": 0
        },
        "redefinitions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "echo": {
      "type": "object",
      "properties": {
        "source_event": {
          "type": "integer",
          "minimum": 0
        },
        "subject_id": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "multimodal": {
      "type": "object",
      "properties": {
        "source_class": {
          "type": "string"
        },
        "source_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "drawing_speed": {
          "type": "number",
          "minimum": 0
        },
        "stroke_count": {
          "type": "integer",
          "minimum": 0
        },
        "direction_changes": {
          "type": "integer",
          "minimum": 0
        },
        "voice_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "speech_rate": {
          "type": "number",
          "minimum": 0
        },
        "pitch_mean_hz": {
          "type": "number",
          "minimum": 0
        },
        "energy_mean": {
          "type": "number",
          "minimum": 0
        },
        "transcript": {
          "type": "string"
        },
        "consent_tier": {
          "enum": [
            "C0_LOCAL",
            "C1_PRIVATE",
            "C2_AGGREGATED",
            "C3_CAMPAIGN",
            "C4_PUBLIC"
          ]
        },
        "candidate_response": {
          "type": "string"
        },
        "human_status": {
          "enum": [
            "UNSET",
            "KEEP",
            "MUTATE",
            "PARK",
            "KILL"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
