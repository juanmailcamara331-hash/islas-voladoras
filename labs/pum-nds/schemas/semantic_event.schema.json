{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISL Semantic Event Packet",
  "type": "object",
  "required": ["event_id","run_id","device","kind","tick","payload_version"],
  "properties": {
    "event_id": {"type":"string"},
    "run_id": {"type":"string"},
    "device": {"type":"string","enum":["R36","TABLET","DESKTOP","UNREAL_TEST"]},
    "kind": {"type":"string"},
    "tick": {"type":"integer","minimum":0},
    "payload_version": {"type":"integer","minimum":1},
    "gesture": {
      "type":"object",
      "properties":{
        "samples":{"type":"integer","minimum":0},
        "distance":{"type":"integer","minimum":0},
        "direction_changes":{"type":"integer","minimum":0},
        "duration_frames":{"type":"integer","minimum":0}
      },
      "additionalProperties":true
    },
    "voice": {
      "type":"object",
      "properties":{
        "energy_band":{"type":"integer","minimum":0,"maximum":7},
        "duration_ms":{"type":"integer","minimum":0},
        "rhythm_class":{"type":"integer","minimum":0},
        "pitch_change_band":{"type":"integer","minimum":0}
      },
      "additionalProperties":true
    },
    "game": {
      "type":"object",
      "additionalProperties":true
    },
    "provenance": {
      "type":"object",
      "additionalProperties":true
    }
  },
  "additionalProperties":true
}
