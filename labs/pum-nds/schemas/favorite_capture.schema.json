{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISL PUM Favorite Capture",
  "type": "object",
  "required": [
    "capture_id",
    "run_id",
    "game_tick",
    "source",
    "privacy"
  ],
  "properties": {
    "capture_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "build_sha": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "game_tick": {
      "type": "integer",
      "minimum": 0
    },
    "context": {
      "type": "string"
    },
    "source": {
      "enum": [
        "tap",
        "voice",
        "photo",
        "mixed"
      ]
    },
    "what_i_liked": {
      "type": "string"
    },
    "why_i_liked": {
      "type": "string"
    },
    "how_it_felt_user_words": {
      "type": "string"
    },
    "voice_transcript": {
      "type": "string"
    },
    "photo_ref": {
      "type": "string"
    },
    "asset_hash": {
      "type": "string"
    },
    "tempo_band": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "biography_refs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "echo_refs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "route": {
      "type": "string"
    },
    "human_status": {
      "enum": [
        "KEEP",
        "PARK",
        "MUTATE",
        "UNSET"
      ]
    },
    "privacy": {
      "enum": [
        "PRIVATE",
        "SHAREABLE",
        "PUBLIC_APPROVED"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
